---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';

const shortcuts = [
  { label: 'Shop supplies', href: '/shop/', icon: 'lucide:palette' },
  { label: 'Workshops', href: '/workshops/', icon: 'lucide:calendar-heart' },
  { label: 'DIY kits', href: '/diy-kits/', icon: 'lucide:package-open' },
  { label: 'Contact us', href: '/contact/', icon: 'lucide:message-circle' },
];
---

<BaseLayout
  title="Page not found"
  description="This page has wandered off. Find your way back to Craft & Colours."
  noindex
>
  <section class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="font-display text-[7rem] leading-none tracking-tight text-poppy-500 sm:text-[10rem]"
        aria-hidden="true"
      >
        4<span class="inline-block -rotate-12 text-marigold-500">0</span>4
      </p>

      <p class="eyebrow mt-4">Page not found</p>
      <h1 class="mt-3 text-balance font-display text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
        This page unravelled like a loose stitch.
      </h1>
      <p class="mx-auto mt-5 max-w-md text-sm leading-7 text-ink-500">
        The link may be old, or the page has moved. Try a search, or pick up
        where you left off below.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button type="button" class="btn-primary" data-search-open>
          <Icon name="lucide:search" />
          Search the shop
        </button>
        <a href="/" class="btn-secondary">Back to home</a>
      </div>

      <ul class="mx-auto mt-12 grid max-w-xl grid-cols-2 gap-3 sm:grid-cols-4">
        {shortcuts.map((item) => (
          <li>
            <a
              href={item.href}
              class="card card-hover flex h-full flex-col items-center gap-2 px-3 py-5 text-sm font-semibold text-ink-900"
            >
              <span class="grid h-10 w-10 place-items-center rounded-full bg-olive-100 text-olive-700">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
