---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ShopFilters from "../../components/store/ShopFilters";
import { optimizeProductImages } from "../../lib/cms-image";
import {
    getCategories,
    getCategoryFilters,
    getProducts,
} from "../../lib/woocommerce";

const [products, categories, categoryFilters] = await Promise.all([
    getProducts(),
    getCategories(),
    getCategoryFilters(),
]);

// Only the first image shows on a shop card.
const productsWithImages = await Promise.all(
    products.map(async (product) => ({
        ...product,
        images: await optimizeProductImages(
            product.images.slice(0, 1),
            [320, 480, 640, 800],
        ),
    })),
);
const formattedCategories = categories.map((c) => ({
    name: c.name,
    slug: c.slug,
    count: c.count,
}));
---

<BaseLayout
    title="Shop art supplies, haberdashery and DIY kits in Nairobi"
    description="Shop paint, fabric, yarn, clay, sketchbooks, kids’ projects and DIY kits at Village Market, Nairobi."
>
    <section class="border-b border-ink-900/10 bg-cream-100/50">
        <div class="container-page py-12 sm:py-16">
            <Breadcrumbs items={[{ label: "Shop" }]} />
            <div class="mt-8 grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-end">
                <div>
                    <p class="eyebrow">The collection</p>
                    <h1
                        class="mt-3 text-balance text-5xl leading-[0.98] tracking-tight text-ink-900 sm:text-6xl"
                    >
                        Supplies for<br />your next idea.
                    </h1>
                </div>
                <p class="max-w-md text-sm leading-7 text-ink-500 md:pb-2">
                    Paint, stitch and sew, clay, sketch, kids’ projects and DIY
                    kits. Chosen by our team at Village Market, Nairobi.
                </p>
            </div>
        </div>
    </section>

    <section class="container-page py-10 sm:py-14">
        <!--
      The static HTML shows every product; filters in the query string are only
      applied once ShopFilters hydrates. For filtered URLs, hide the results
      until then so "all products" never flashes before the filtered view.
      Runs before the grid below is parsed. The timeout is a fallback in case
      the island never loads.
    -->
        <script is:inline>
            if (window.location.search.length > 1) {
                document.documentElement.setAttribute(
                    "data-shop-filtering",
                    "",
                );
                setTimeout(
                    () =>
                        document.documentElement.removeAttribute(
                            "data-shop-filtering",
                        ),
                    4000,
                );
            }
        </script>
        <ShopFilters
            client:load
            products={productsWithImages}
            categories={formattedCategories}
            categoryFilters={categoryFilters}
        />
    </section>
</BaseLayout>

<style is:global>
    [data-shop-filtering] [data-shop-results] {
        visibility: hidden;
    }
</style>
