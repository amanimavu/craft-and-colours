---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CheckoutForm from '../components/store/CheckoutForm';
---

<BaseLayout
  title="Checkout"
  description="Complete your Craft & Colours order."
  noindex
>
  <section class="container-page py-10 sm:py-14">
    <Breadcrumbs
      items={[
        { href: '/cart/', label: 'Cart' },
        { label: 'Checkout' },
      ]}
    />

    <div class="mt-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Secure checkout</p>
        <h1 class="mt-3 font-display text-5xl leading-none tracking-tight text-ink-900 sm:text-6xl">
          Checkout
        </h1>
        <p class="mt-4 text-sm leading-7 text-ink-500">
          Delivery details first, then payment. Your details are used only to
          fulfil this order.
        </p>
      </div>
      <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-olive-700">
        <span class="inline-block h-2 w-2 rounded-full bg-olive-500" aria-hidden="true"></span>
        Encrypted connection
      </p>
    </div>

    <div class="mt-10">
      <CheckoutForm client:load />
    </div>
  </section>
</BaseLayout>
