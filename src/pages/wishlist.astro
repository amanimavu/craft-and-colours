---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WishlistView from '../components/store/WishlistView';
---

<BaseLayout
  title="Your wishlist"
  description="Pieces you have saved from the Craft & Colours collection."
  noindex
>
  <section class="container-page py-12 sm:py-16">
    <Breadcrumbs items={[{ href: '/shop/', label: 'Shop' }, { label: 'Wishlist' }]} />
    <div class="mt-8 max-w-2xl">
      <p class="eyebrow">Saved for later</p>
      <h1 class="mt-3 text-balance text-5xl leading-[0.98] tracking-tight text-ink-900 sm:text-6xl">
        Your wishlist
      </h1>
      <p class="mt-4 text-sm leading-7 text-ink-500">
        A little pile of things worth coming back to. Saved in this browser,
        no account needed.
      </p>
    </div>

    <div class="mt-10">
      <WishlistView client:load />
    </div>
  </section>
</BaseLayout>
