---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { getStoreUrl } from '../lib/cart-api';

const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@craftandcolours.co.ke';
const whatsapp = (import.meta.env.PUBLIC_WHATSAPP || '+254700000000').replace(/[^0-9]/g, '');
---

<BaseLayout
  title="Thank you for your order"
  description="Your Craft & Colours order has been received."
  noindex
>
  <section class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-olive-100 text-olive-700">
        <Icon name="lucide:check" class="h-8 w-8" />
      </div>

      <p class="eyebrow mt-6">Order received</p>
      <h1 class="mt-3 text-balance font-display text-5xl leading-[1.02] tracking-tight text-ink-900 sm:text-6xl">
        Thank you. It means a lot.
      </h1>
      <p id="order-intro" class="mx-auto mt-5 max-w-lg text-sm leading-8 text-ink-500">
        We have received your order and will begin preparing it by hand. You
        will get an email confirmation shortly with the details and tracking
        information once it is on its way.
      </p>

      <!-- Shown for "Order now, pay on confirmation" orders (?pay=whatsapp): nothing was
           charged online, so the next step is to message the shop. -->
      <div
        id="whatsapp-step"
        hidden
        data-whatsapp={whatsapp}
        class="mx-auto mt-8 max-w-md rounded-3xl border border-olive-500/30 bg-olive-100 p-6 text-left"
      >
        <p class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-olive-700">
          Next step · payment
        </p>
        <p class="mt-2 font-display text-2xl leading-snug text-ink-900">
          Send us your order on WhatsApp
        </p>
        <p class="mt-2 text-sm leading-6 text-ink-700">
          Your items are reserved. We’ll confirm delivery and send M-Pesa or
          card payment details. Your order ships once it’s paid.
        </p>
        <a
          id="whatsapp-link"
          href={`https://wa.me/${whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-bold text-ink-900 transition duration-200 ease-bounce hover:-translate-y-0.5 hover:shadow-soft"
        >
          <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
          Message us to pay
        </a>
      </div>

      <div class="mx-auto mt-8 max-w-md rounded-2xl border border-ink-900/10 bg-white/60 p-6">
        <p class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-300">
          Order number
        </p>
        <p id="order-number" class="mt-2 font-display text-2xl text-ink-900">
          —
        </p>
        <p class="mt-3 text-xs leading-6 text-ink-500">
          Keep this number handy if you need to contact us about your order.
        </p>
      </div>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/shop/" class="btn-primary">Continue shopping</a>
        <a href={`mailto:${email}`} class="btn-secondary">Contact the shop</a>
      </div>

      <p class="mt-8 text-xs leading-6 text-ink-300">
        Payment and order emails are sent by our store at
        {getStoreUrl() || 'the connected WordPress store'}.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const order = params.get('order');
  const target = document.getElementById('order-number');
  if (order && target) {
    target.textContent = order.startsWith('#') ? order : `#${order}`;
  }

  // "Order now, pay on confirmation": reveal the next-step card with a prefilled message.
  const whatsappStep = document.getElementById('whatsapp-step');
  if (params.get('pay') === 'whatsapp' && whatsappStep) {
    const total = params.get('total');
    const orderLabel = order ? `#${order.replace(/^#/, '')}` : 'my order';
    const message = `Hi Craft & Colours! I've just placed order ${orderLabel}${
      total ? ` (${total})` : ''
    }. How do I pay?`;
    const link = document.getElementById('whatsapp-link') as HTMLAnchorElement | null;
    if (link) {
      link.href = `https://wa.me/${whatsappStep.dataset.whatsapp}?text=${encodeURIComponent(message)}`;
    }
    whatsappStep.hidden = false;

    const intro = document.getElementById('order-intro');
    if (intro) {
      intro.textContent =
        'Your order is in and your items are set aside. One more step: message us on WhatsApp to pay, and we will start preparing it by hand.';
    }
  }

  // One celebratory burst per order, skipped on reload and for reduced motion.
  const confettiKey = `craft-confetti-${order ?? 'demo'}`;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && !sessionStorage.getItem(confettiKey)) {
    sessionStorage.setItem(confettiKey, '1');
    launchConfetti();
  }

  function launchConfetti() {
    const colors = ['#ff5e36', '#ff6584', '#ffaa00', '#2354e6', '#6f7d3f', '#d99a7b'];
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    canvas.className = 'pointer-events-none fixed inset-0 z-[90] h-full w-full';
    document.body.append(canvas);

    const ctx = canvas.getContext('2d');
    if (!ctx) return canvas.remove();

    const dpr = window.devicePixelRatio || 1;
    const resize = () => {
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    const width = window.innerWidth;
    const pieces = Array.from({ length: 160 }, (_, index) => {
      const fromLeft = index % 2 === 0;
      return {
        x: fromLeft ? width * 0.1 : width * 0.9,
        y: window.innerHeight * 0.75,
        vx: (fromLeft ? 1 : -1) * (3 + Math.random() * 7),
        vy: -(10 + Math.random() * 9),
        size: 6 + Math.random() * 6,
        rotation: Math.random() * Math.PI,
        spin: (Math.random() - 0.5) * 0.3,
        color: colors[index % colors.length],
        round: Math.random() > 0.6,
      };
    });

    const start = performance.now();
    const duration = 3600;

    const frame = (now: number) => {
      const elapsed = now - start;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      ctx.globalAlpha = Math.min(1, (duration - elapsed) / 800);

      for (const piece of pieces) {
        piece.vx *= 0.985;
        piece.vy = piece.vy * 0.985 + 0.32;
        piece.x += piece.vx;
        piece.y += piece.vy;
        piece.rotation += piece.spin;

        ctx.save();
        ctx.translate(piece.x, piece.y);
        ctx.rotate(piece.rotation);
        ctx.fillStyle = piece.color;
        if (piece.round) {
          ctx.beginPath();
          ctx.arc(0, 0, piece.size / 2, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillRect(-piece.size / 2, -piece.size / 4, piece.size, piece.size / 2);
        }
        ctx.restore();
      }

      if (elapsed < duration) {
        requestAnimationFrame(frame);
      } else {
        window.removeEventListener('resize', resize);
        canvas.remove();
      }
    };

    requestAnimationFrame(frame);
  }
</script>
