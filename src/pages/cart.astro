---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CartView from '../components/store/CartView';
---

<BaseLayout
  title="Your cart"
  description="Review your Craft & Colours cart."
  noindex
>
  <section class="container-page py-10 sm:py-14">
    <Breadcrumbs items={[{ label: 'Cart' }]} />

    <div class="mt-8 max-w-2xl">
      <p class="eyebrow">Almost there</p>
      <h1 class="mt-3 font-display text-5xl leading-none tracking-tight text-ink-900 sm:text-6xl">
        Your cart
      </h1>
      <p class="mt-4 text-sm leading-7 text-ink-500">
        A small collection of useful things. Review your pieces, apply a coupon
        and continue when you are ready.
      </p>
    </div>

    <div class="mt-10">
      <CartView client:load />
    </div>
  </section>
</BaseLayout>
