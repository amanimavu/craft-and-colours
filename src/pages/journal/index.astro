---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatDate } from '../../lib/format';
import { getPosts } from '../../lib/wordpress';

const posts = await getPosts(24);
const [lead, ...rest] = posts;
---

<BaseLayout
  title="The journal | Notes from the shop"
  description="Notes on colour, materials, making and keeping things. From the Craft & Colours shop at Village Market, Nairobi."
>
  <section class="border-b border-ink-900/10 bg-cream-100/50">
    <div class="container-page py-12 sm:py-16">
      <Breadcrumbs items={[{ label: 'Journal' }]} />
      <div class="mt-8 grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-end">
        <div>
          <p class="eyebrow">From the shop</p>
          <h1 class="mt-3 text-balance text-5xl leading-[0.98] tracking-tight text-ink-900 sm:text-6xl">
            Notes on making,<br />colour &amp; keeping things.
          </h1>
        </div>
        <p class="max-w-md text-sm leading-7 text-ink-500 md:pb-2">
          Occasional writing about the materials we use, the people we work
          with, and the small decisions that shape a useful object.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    {lead ? (
      <article class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <a href={`/journal/${lead.slug}/`} class="group block overflow-hidden rounded-[2rem]">
          <div class="aspect-[4/3] overflow-hidden bg-cream-200">
            {lead.image ? (
              <img
                src={lead.image.src}
                alt={lead.image.alt}
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                fetchpriority="high"
              />
            ) : (
              <div class="h-full w-full bg-cream-200" />
            )}
          </div>
        </a>

        <div class="lg:pl-6">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.16em] text-ink-300">
            {lead.categories[0] ?? 'Journal'} · {formatDate(lead.date)}
          </p>
          <h2 class="mt-4 text-balance font-display text-4xl leading-[1.04] text-ink-900 sm:text-5xl">
            <a href={`/journal/${lead.slug}/`} class="hover:text-clay-600">
              {lead.title}
            </a>
          </h2>
          <p class="mt-5 text-base leading-8 text-ink-500">{lead.excerpt}</p>
          <a href={`/journal/${lead.slug}/`} class="btn-secondary mt-7">
            Read the story
          </a>
        </div>
      </article>
    ) : (
      <p class="text-sm text-ink-500">The first stories are on their way.</p>
    )}

    {rest.length > 0 && (
      <div class="mt-14 grid gap-x-6 gap-y-12 border-t border-ink-900/10 pt-12 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((post) => (
          <article class="group">
            <a href={`/journal/${post.slug}/`} class="block overflow-hidden rounded-2xl">
              <div class="aspect-[3/2] overflow-hidden bg-cream-200">
                {post.image ? (
                  <img
                    src={post.image.src}
                    alt={post.image.alt}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                ) : (
                  <div class="h-full w-full bg-cream-200" />
                )}
              </div>
            </a>
            <p class="mt-4 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-ink-300">
              {post.categories[0] ?? 'Journal'} · {formatDate(post.date)}
            </p>
            <h3 class="mt-2 font-display text-2xl leading-tight text-ink-900">
              <a href={`/journal/${post.slug}/`} class="hover:text-clay-600">
                {post.title}
              </a>
            </h3>
            <p class="mt-3 text-sm leading-7 text-ink-500">{post.excerpt}</p>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
