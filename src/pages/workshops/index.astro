---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import WorkshopSeats from '../../components/WorkshopSeats.astro';
import { getUpcomingWorkshops, getPastWorkshops, isFullyBooked } from '../../lib/workshops';
import { formatMoney } from '../../lib/format';

const upcoming = await getUpcomingWorkshops();
const past = await getPastWorkshops();
const featured = upcoming[0];
const remainingUpcoming = upcoming.slice(1);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Workshops & Meetups | Craft & Colours',
  description: 'Upcoming and past workshops, free meetups and craft sessions at Village Market, Nairobi.',
  url: Astro.url.toString(),
};
---

<BaseLayout
  title="Workshops & Meetups | Craft & Colours Nairobi"
  description="Join our weekend workshops, free Sunday crochet club and craft meetups at Village Market, Nairobi."
  schema={schema}
>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-2xl">
      <p class="eyebrow">Studio &amp; Community</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
        Workshops, meetups &amp; the big table
      </h1>
      <p class="mt-4 text-base leading-7 text-ink-500">
        Come make something with us at Village Market. Whether you are picking up a crochet hook for the first time or spending a Saturday evening painting, there is a seat for you at the table.
      </p>
    </header>

    {featured && (
      <section class="mt-12 rounded-3xl border border-ink-900/10 bg-olive-700 p-6 text-cream-50 sm:p-10 lg:p-12">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-olive-100/80">
          Next upcoming session
        </p>
        <div class="mt-6 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
          <div class="overflow-hidden rounded-2xl bg-olive-500/30 aspect-[16/10]">
            <img
              src={featured.image.src}
              alt={featured.image.alt}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="space-y-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-olive-100 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-olive-700">
                {featured.isFree ? 'Free meetup' : 'Workshop'}
              </span>
              <span class="text-xs font-semibold text-olive-100/80">
                {featured.date ? new Date(featured.date).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : ''} · {featured.time}
              </span>
            </div>

            <h2 class="font-display text-3xl leading-tight sm:text-4xl">
              {featured.title}
            </h2>

            <div class="text-base leading-7 text-olive-100/90" set:html={featured.description} />

            <div class="grid grid-cols-2 gap-4 rounded-2xl bg-olive-500/20 p-5 text-sm">
              <div>
                <p class="text-[0.68rem] uppercase tracking-[0.14em] text-olive-100/70 font-bold">Location</p>
                <p class="mt-1 font-semibold text-cream-50">{featured.location}</p>
              </div>
              <div>
                <p class="text-[0.68rem] uppercase tracking-[0.14em] text-olive-100/70 font-bold">Duration &amp; Skill</p>
                <p class="mt-1 font-semibold text-cream-50">{featured.duration} · {featured.skill}</p>
              </div>
            </div>

            <WorkshopSeats workshop={featured} tone="dark" />

            <div class="flex flex-wrap items-center gap-4 pt-2">
              {isFullyBooked(featured) ? (
                <>
                  <span class="inline-flex items-center gap-2 rounded-full bg-cream-50/10 px-4 py-2 text-sm font-bold text-marigold-500">
                    <Icon name="lucide:users-round" class="h-4 w-4" />
                    Fully booked
                  </span>
                  <a
                    href={`/workshops/${featured.slug}/`}
                    class="text-sm font-bold text-cream-50 underline underline-offset-4 hover:text-marigold-500"
                  >
                    Join the waitlist
                  </a>
                </>
              ) : (
                <a
                  href={`/workshops/${featured.slug}/`}
                  class="inline-flex items-center gap-2 rounded-full bg-poppy-500 px-6 py-3 text-sm font-bold text-cream-50 transition hover:bg-poppy-600"
                >
                  {featured.isFree
                    ? 'RSVP / Join meetup — free'
                    : `Save my spot — ${formatMoney(featured.price.price, featured.price.currency_code, featured.price.currency_minor_unit)}`}
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    {remainingUpcoming.length > 0 && (
      <section class="mt-20">
        <h2 class="font-display text-2xl sm:text-3xl text-ink-900">
          More upcoming sessions
        </h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {remainingUpcoming.map((workshop) => (
            <article class="flex flex-col justify-between rounded-3xl border border-ink-900/10 bg-white/60 p-6 shadow-sm">
              <div>
                <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-cream-200">
                  <img
                    src={workshop.image.src}
                    alt={workshop.image.alt}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-olive-100 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-olive-700">
                    {workshop.isFree ? 'Free meetup' : 'Workshop'}
                  </span>
                  <span class="text-[0.68rem] font-semibold text-ink-500">
                    {workshop.date ? new Date(workshop.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : ''} · {workshop.time}
                  </span>
                </div>
                <h3 class="mt-3 font-display text-xl leading-tight text-ink-900">
                  <a href={`/workshops/${workshop.slug}/`} class="hover:text-clay-600">
                    {workshop.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500">
                  {workshop.excerpt}
                </p>
              </div>
              <div class="mt-6 flex items-center justify-between gap-3 border-t border-ink-900/10 pt-4 text-xs font-semibold">
                <span class="text-ink-900">
                  {workshop.isFree
                    ? 'Free'
                    : formatMoney(workshop.price.price, workshop.price.currency_code, workshop.price.currency_minor_unit)}
                  {isFullyBooked(workshop) ? (
                    <span class="ml-1 font-bold text-poppy-600">· Fully booked</span>
                  ) : (
                    <span class="ml-1 font-medium text-ink-400">· {workshop.seatsLeft} left</span>
                  )}
                </span>
                <a
                  href={`/workshops/${workshop.slug}/`}
                  class="inline-flex items-center gap-1 text-poppy-600 hover:underline"
                >
                  {isFullyBooked(workshop) ? 'Join waitlist' : workshop.isFree ? 'RSVP' : 'Book spot'}
                  <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {past.length > 0 && (
      <section class="mt-24 border-t border-ink-900/10 pt-16">
        <h2 class="font-display text-2xl sm:text-3xl text-ink-900">
          Past sessions &amp; meetups
        </h2>
        <p class="mt-2 text-sm text-ink-500">
          A look at some of our recent gatherings at Village Market.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {past.map((workshop) => (
            <article class="flex flex-col justify-between rounded-3xl border border-ink-900/10 bg-cream-100/50 p-6 opacity-80">
              <div>
                <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-cream-200">
                  <img
                    src={workshop.image.src}
                    alt={workshop.image.alt}
                    loading="lazy"
                    class="h-full w-full object-cover grayscale"
                  />
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-ink-900/10 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-ink-700">
                    Completed
                  </span>
                  <span class="text-[0.68rem] font-semibold text-ink-500">
                    {workshop.date ? new Date(workshop.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
                  </span>
                </div>
                <h3 class="mt-3 font-display text-xl leading-tight text-ink-900">
                  {workshop.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500">
                  {workshop.excerpt}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
