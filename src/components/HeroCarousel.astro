---
import { getImage } from "astro:assets";
import Icon from "./ui/Icon.astro";
import { getCategories } from "../lib/woocommerce";

import brandWide from "../assets/images/landing-page-hero-image.png";
import brandLandscape from "../assets/images/hero-carousel/landing-page-hero-image_3_to_2.png";
import brandPortrait from "../assets/images/hero-carousel/landing-page-hero-image_9_to_16.png";
import yarnLandscape from "../assets/images/hero-carousel/colourful-yarn-and-crochet-flat-lay-3_to_2.png";
import yarnPortrait from "../assets/images/hero-carousel/colourful-yarn-and-crochet-flat-lay-9_to_16.png";
import hooksLandscape from "../assets/images/hero-carousel/colorful-crochet-supplies-on-blue-3_to_2.png";
import hooksPortrait from "../assets/images/hero-carousel/colorful-crochet-supplies-on-blue-9_to_16.png";
import stationeryLandscape from "../assets/images/hero-carousel/colorful-stationery-flat-lay-on-pink-3_to_2.png";
import stationeryPortrait from "../assets/images/hero-carousel/colorful-stationery-flat-lay-on-pink-9_to_16.png";
import artLandscape from "../assets/images/hero-carousel/colorful-artist-supplies-flat-lay-3_to_2.png";
import artPortrait from "../assets/images/hero-carousel/colorful-artist-supplies-flat-lay-9_to_16.png";
import giftingLandscape from "../assets/images/hero-carousel/vibrant-gift-wrapping-flat-lay-3_to_2.png";
import giftingPortrait from "../assets/images/hero-carousel/vibrant-gift-wrapping-flat-lay-9_to_16.png";

interface Slide {
    /** Short name, used for the dot buttons' labels. */
    name: string;
    alt: string;
    /** 9:16 crop, phones. */
    portrait: ImageMetadata;
    /** 3:2 crop, tablets (and desktop unless `wide` is set). */
    landscape: ImageMetadata;
    /** Optional wider crop for desktop. */
    wide?: ImageMetadata;
    /** Slides without copy show the image alone (the brand collage). */
    copy?: {
        eyebrow: string;
        title: string;
        cta: string;
        /** Shop categories to link to, best match first. Each entry is matched
         * against the CMS category slugs and names; the button links to the
         * first one that exists and has products, otherwise to the whole shop. */
        categories: string[];
        /** Text colour on tablet/desktop, where copy sits on the backdrop. */
        tone: "ink" | "cream";
    };
}

// The landscape images keep their left ~40% clear for this copy. Each slide
// links to its WordPress category; the older categories after it are
// fallbacks for while the new ones are being set up.
const slides: Slide[] = [
    {
        name: "Craft & Colours",
        alt: "A colourful flat-lay of paint, yarn, clay, fabric and craft supplies spelling Craft & Colours",
        portrait: brandPortrait,
        landscape: brandLandscape,
        wide: brandWide,
    },
    {
        name: "Yarn",
        alt: "Balls and skeins of colourful yarn with a granny square on a marigold backdrop",
        portrait: yarnPortrait,
        landscape: yarnLandscape,
        copy: {
            eyebrow: "Yarn",
            title: "Squishy yarn in every colour",
            cta: "Shop yarn",
            categories: ["yarn", "stitch-sew"],
            tone: "ink",
        },
    },
    {
        name: "Hooks",
        alt: "A rainbow fan of crochet hooks with stitch markers, scissors and yarn on a cobalt backdrop",
        portrait: hooksPortrait,
        landscape: hooksLandscape,
        copy: {
            eyebrow: "Hooks & notions",
            title: "A hook for every hand",
            cta: "Shop hooks",
            categories: ["hooks", "hook", "stitch-sew"],
            tone: "cream",
        },
    },
    {
        name: "Stationery",
        alt: "Notebooks, washi tape, highlighters and sticky notes on a pink backdrop",
        portrait: stationeryPortrait,
        landscape: stationeryLandscape,
        copy: {
            eyebrow: "Stationery",
            title: "Happy desk, happy you",
            cta: "Shop stationery",
            categories: ["stationery", "sketch"],
            tone: "ink",
        },
    },
    {
        name: "Art supplies",
        alt: "Paint tubes, a palette, brushes, watercolours and coloured pencils on a cream backdrop",
        portrait: artPortrait,
        landscape: artLandscape,
        copy: {
            eyebrow: "Art supplies",
            title: "Paint, pastels & everything in between",
            cta: "Shop art supplies",
            categories: ["art-supplies", "art", "paint"],
            tone: "ink",
        },
    },
    {
        name: "Gifting",
        alt: "Gift boxes, satin ribbons, twine and kraft gift tags on a blush backdrop",
        portrait: giftingPortrait,
        landscape: giftingLandscape,
        copy: {
            eyebrow: "Ribbons & gift boxes",
            title: "Wrap it like you mean it",
            cta: "Shop gifting",
            categories: ["gifting", "gifts", "gift", "bundles"],
            tone: "ink",
        },
    },
];

// Categories come from the CMS; empty ones are skipped so a button never
// opens an empty shop page.
const shopCategories = await getCategories();
const toKey = (value: string) =>
    value
        .toLowerCase()
        .replace(/&/g, "and")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

const categoryHref = (wanted: string[]) => {
    for (const key of wanted.map(toKey)) {
        const match = shopCategories.find(
            (category) =>
                category.count > 0 &&
                (toKey(category.slug) === key || toKey(category.name) === key),
        );
        if (match) return `/shop/?category=${encodeURIComponent(match.slug)}`;
    }
    return "/shop/";
};

const widthsUpTo = (image: ImageMetadata, widths: number[]) => [
    ...widths.filter((w) => w < image.width),
    image.width,
];

const rendered = await Promise.all(
    slides.map(async (slide) => {
        const [portrait, landscape, wide] = await Promise.all([
            getImage({
                src: slide.portrait,
                widths: widthsUpTo(slide.portrait, [480, 720]),
            }),
            getImage({
                src: slide.landscape,
                widths: widthsUpTo(slide.landscape, [768, 1152]),
            }),
            slide.wide
                ? getImage({
                      src: slide.wide,
                      widths: widthsUpTo(slide.wide, [1280, 1600]),
                  })
                : undefined,
        ]);
        return {
            ...slide,
            portrait,
            landscape,
            wide,
            href: slide.copy ? categoryHref(slide.copy.categories) : undefined,
        };
    }),
);
---

<div
    class="hero-carousel relative isolate aspect-[9/16] w-full overflow-hidden bg-cream-100 sm:aspect-[3/2]"
    role="region"
    aria-roledescription="carousel"
    aria-label="Shop our main categories"
    data-hero-carousel
>
    {
        rendered.map((slide, index) => (
            <div
                class:list={[
                    "hero-slide absolute inset-0",
                    index === 0 && "is-active",
                ]}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${rendered.length}: ${slide.name}`}
                data-slide
            >
                <picture class="block h-full w-full">
                    <source
                        media="(max-width: 639px)"
                        srcset={slide.portrait.srcSet.attribute}
                        sizes="100vw"
                    />
                    {slide.wide && (
                        <source
                            media="(min-width: 1024px) and (min-aspect-ratio: 16/9)"
                            srcset={slide.wide.srcSet.attribute}
                            sizes="100vw"
                        />
                    )}
                    <img
                        src={slide.landscape.src}
                        srcset={slide.landscape.srcSet.attribute}
                        sizes="100vw"
                        width={slide.landscape.attributes.width}
                        height={slide.landscape.attributes.height}
                        alt={slide.alt}
                        class="h-full w-full object-cover"
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "low"}
                        decoding="async"
                    />
                </picture>

                {slide.copy && (
                    <div
                        class:list={[
                            // Phones: frosted-glass card top-left, under the location sticker.
                            "hero-slide-copy absolute left-4 top-14 max-w-[78%] rounded-2xl bg-white/35 p-4 text-ink-900 shadow-soft ring-1 ring-white/60 backdrop-blur-md backdrop-saturate-150",
                            // Tablet/desktop: plain text on the empty left of the image.
                            "sm:left-[6%] sm:top-1/2 sm:max-w-[36%] sm:-translate-y-1/2 sm:rounded-none sm:bg-transparent sm:p-0 sm:shadow-none sm:ring-0 sm:backdrop-blur-none sm:backdrop-saturate-100",
                            slide.copy.tone === "cream" && "sm:text-cream-50",
                        ]}
                    >
                        <p
                            class:list={[
                                "eyebrow text-ink-900",
                                slide.copy.tone === "cream"
                                    ? "sm:text-cream-50"
                                    : "sm:text-ink-900",
                            ]}
                        >
                            {slide.copy.eyebrow}
                        </p>
                        <p class="mt-2 text-balance font-display text-3xl leading-[1.05] tracking-tight sm:mt-3 sm:text-4xl lg:text-6xl">
                            {slide.copy.title}
                        </p>
                        <a
                            href={slide.href}
                            class:list={[
                                "btn-wiggle mt-4 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold transition sm:mt-6 lg:px-6 lg:py-3",
                                slide.copy.tone === "cream"
                                    ? "bg-ink-900 text-cream-50 hover:bg-poppy-600 sm:bg-cream-50 sm:text-ink-900 sm:hover:bg-marigold-500"
                                    : "bg-ink-900 text-cream-50 hover:bg-poppy-600",
                            ]}
                        >
                            {slide.copy.cta}
                            <Icon name="lucide:arrow-right" class="h-4 w-4" />
                        </a>
                    </div>
                )}
            </div>
        ))
    }

    <div
        class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1 rounded-full bg-cream-50/90 p-1 shadow-sm ring-1 ring-ink-900/10 backdrop-blur-sm"
        data-controls
        hidden
    >
        <button
            type="button"
            class="grid h-8 w-8 cursor-pointer place-items-center rounded-full text-ink-900 transition hover:bg-ink-900 hover:text-cream-50"
            aria-label="Previous slide"
            data-prev
        >
            <Icon name="lucide:chevron-left" class="h-4 w-4" />
        </button>

        <div class="flex items-center">
            {
                rendered.map((slide, index) => (
                    <button
                        type="button"
                        class="group grid h-8 w-6 cursor-pointer place-items-center"
                        aria-label={`Show slide ${index + 1}: ${slide.name}`}
                        aria-current={index === 0 ? "true" : undefined}
                        data-dot
                    >
                        <span class="hero-dot block h-2 w-2 rounded-full bg-ink-900/25 transition-all duration-300 group-hover:bg-ink-900/60" />
                    </button>
                ))
            }
        </div>

        <button
            type="button"
            class="grid h-8 w-8 cursor-pointer place-items-center rounded-full text-ink-900 transition hover:bg-ink-900 hover:text-cream-50"
            aria-label="Next slide"
            data-next
        >
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </button>

        <button
            type="button"
            class="grid h-8 w-8 cursor-pointer place-items-center rounded-full text-ink-900 transition hover:bg-ink-900 hover:text-cream-50"
            aria-label="Pause slideshow"
            data-toggle
        >
            <!-- Icon doesn't forward data-* attributes, so the toggle targets
                 these wrappers. -->
            <span data-icon-pause>
                <Icon name="lucide:pause" class="h-4 w-4" />
            </span>
            <span class="hidden" data-icon-play>
                <Icon name="lucide:play" class="h-4 w-4" />
            </span>
        </button>
    </div>
</div>

<script is:inline>
    // Desktop hero fills the window below the header. Runs before first
    // paint so the hero doesn't jump; re-measured on resize.
    (() => {
        const el = document.currentScript?.previousElementSibling;
        if (!el) return;
        const set = () =>
            el.style.setProperty(
                "--hero-top",
                `${el.getBoundingClientRect().top + window.scrollY}px`,
            );
        set();
        addEventListener("resize", set, { passive: true });
        addEventListener("load", set);
    })();
</script>

<style>
    /* Desktop: exactly fill the window below the header, but never taller
       than a 3:2 frame (keeps the landscape images' sides) and never shorter
       than 28rem. --hero-top is set by the inline script above; the fallback
       is the header's height at this breakpoint. */
    @media (min-width: 1024px) {
        .hero-carousel {
            aspect-ratio: auto;
            height: clamp(
                28rem,
                calc(100svh - var(--hero-top, 6.375rem)),
                66.667vw
            );
        }
    }

    /* Cross-fade: every slide fills the same box. The outgoing slide stays
       visible until its fade finishes (delayed visibility), then drops out of
       the tab order and the accessibility tree. */
    .hero-slide {
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 1100ms ease-in-out,
            visibility 0s linear 1100ms;
    }

    .hero-slide.is-active {
        z-index: 1;
        opacity: 1;
        visibility: visible;
        transition:
            opacity 1100ms ease-in-out,
            visibility 0s linear 0s;
    }

    .hero-slide-copy {
        opacity: 0;
        transition: opacity 700ms ease-out 0ms;
    }

    .is-active .hero-slide-copy {
        opacity: 1;
        transition-delay: 450ms;
    }

    [aria-current="true"] .hero-dot {
        width: 1.25rem;
        background-color: var(--color-ink-900);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-slide,
        .hero-slide.is-active,
        .hero-slide-copy,
        .is-active .hero-slide-copy {
            transition: none;
        }
    }
</style>

<script>
    const INTERVAL_MS = 6000;

    for (const root of document.querySelectorAll<HTMLElement>(
        "[data-hero-carousel]",
    )) {
        const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
        const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
        const controls = root.querySelector<HTMLElement>("[data-controls]");
        const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
        if (slides.length < 2 || !controls || !toggle) continue;

        controls.hidden = false;

        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        let current = 0;
        let timer: number | undefined;
        // Reduced motion: never advance on its own; the controls still work.
        let userPaused = reducedMotion;
        let hovering = false;
        let focused = false;

        const show = (index: number) => {
            const next = (index + slides.length) % slides.length;
            if (next === current) return;
            slides[current]?.classList.remove("is-active");
            dots[current]?.removeAttribute("aria-current");
            slides[next]?.classList.add("is-active");
            dots[next]?.setAttribute("aria-current", "true");
            current = next;
        };

        const stop = () => {
            window.clearInterval(timer);
            timer = undefined;
        };

        const sync = () => {
            stop();
            if (!userPaused && !hovering && !focused && !document.hidden) {
                timer = window.setInterval(() => show(current + 1), INTERVAL_MS);
            }
            toggle.setAttribute(
                "aria-label",
                userPaused ? "Play slideshow" : "Pause slideshow",
            );
            toggle
                .querySelector("[data-icon-pause]")
                ?.classList.toggle("hidden", userPaused);
            toggle
                .querySelector("[data-icon-play]")
                ?.classList.toggle("hidden", !userPaused);
        };

        // A manual move restarts the countdown so the new slide gets its full time.
        const go = (index: number) => {
            show(index);
            sync();
        };

        root.querySelector("[data-prev]")?.addEventListener("click", () =>
            go(current - 1),
        );
        root.querySelector("[data-next]")?.addEventListener("click", () =>
            go(current + 1),
        );
        dots.forEach((dot, index) =>
            dot.addEventListener("click", () => go(index)),
        );
        toggle.addEventListener("click", () => {
            userPaused = !userPaused;
            sync();
        });

        root.addEventListener("pointerenter", (event) => {
            if (event.pointerType === "mouse") {
                hovering = true;
                sync();
            }
        });
        root.addEventListener("pointerleave", () => {
            hovering = false;
            sync();
        });
        // Only keyboard focus pauses; a tapped or clicked control keeps focus
        // and would otherwise stop the slideshow for good.
        root.addEventListener("focusin", (event) => {
            if ((event.target as Element).matches(":focus-visible")) {
                focused = true;
                sync();
            }
        });
        root.addEventListener("focusout", (event) => {
            if (!root.contains(event.relatedTarget as Node | null)) {
                focused = false;
                sync();
            }
        });
        document.addEventListener("visibilitychange", sync);

        root.addEventListener("keydown", (event) => {
            if (event.key === "ArrowLeft") go(current - 1);
            if (event.key === "ArrowRight") go(current + 1);
        });

        // Horizontal swipe on touch screens.
        let startX = 0;
        let startY = 0;
        root.addEventListener(
            "touchstart",
            (event) => {
                startX = event.touches[0]?.clientX ?? 0;
                startY = event.touches[0]?.clientY ?? 0;
            },
            { passive: true },
        );
        root.addEventListener(
            "touchend",
            (event) => {
                const dx = (event.changedTouches[0]?.clientX ?? 0) - startX;
                const dy = (event.changedTouches[0]?.clientY ?? 0) - startY;
                if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
                    go(dx < 0 ? current + 1 : current - 1);
                }
            },
            { passive: true },
        );

        sync();
    }
</script>
