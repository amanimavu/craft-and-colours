---
import Icon from "./ui/Icon.astro";
import Badge from "./ui/Badge.astro";
import { formatCardPrice } from "../lib/format";
import type { Product } from "../lib/types";

interface Props {
    bestsellers: Product[];
    bundles: Product[];
    giftThreshold: number;
}

const { bestsellers, bundles, giftThreshold } = Astro.props;

const threshold = new Intl.NumberFormat("en-KE", {
    maximumFractionDigits: 0,
}).format(giftThreshold);
---

<section class="relative bg-[#f8f2e8] py-16 sm:py-20">
    <div
        class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-butter-50 to-transparent sm:h-28"
        aria-hidden="true"
    />
    <div class="container-page">
        <div
            class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
        >
            <div class="max-w-2xl">
                <p class="eyebrow">Most loved</p>
                <h2
                    class="mt-3 text-balance text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl"
                >
                    The ones that keep flying off the shelf.
                </h2>
            </div>
            <a
                href="/shop/"
                class="inline-flex items-center gap-2 text-sm font-bold text-ink-900 underline decoration-poppy-500 decoration-2 underline-offset-4 transition hover:text-poppy-600"
            >
                Shop all supplies
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
            <ol class="divide-y divide-ink-900/10 border-y border-ink-900/10">
                {
                    bestsellers.map((product, index) => {
                        const image = product.images[0];
                        const rating = product.rating ?? 0;
                        const reviews = product.reviewCount ?? 0;
                        return (
                            <li>
                                <a
                                    href={`/shop/${product.slug}/`}
                                    class="group flex items-center gap-4 py-4"
                                >
                                    <span class="w-7 shrink-0 font-display text-xl text-ink-300">
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                    <img
                                        src={image?.src}
                                        alt={image?.alt ?? product.name}
                                        loading="lazy"
                                        decoding="async"
                                        class="h-16 w-16 shrink-0 rounded-xl bg-cream-200 object-cover sm:h-20 sm:w-20"
                                    />
                                    <span class="min-w-0 flex-1">
                                        <span class="block text-[0.6rem] font-bold uppercase tracking-[0.16em] text-ink-300">
                                            {product.categories[0]?.name ??
                                                "Supplies"}
                                        </span>
                                        <span class="mt-1 block font-display text-lg leading-snug text-ink-900 transition group-hover:text-poppy-600 sm:text-xl">
                                            {product.name}
                                        </span>
                                        {reviews > 0 && (
                                            <span class="mt-1 flex items-center gap-1.5 text-xs text-ink-500">
                                                <Icon
                                                    name="lucide:star"
                                                    class="h-3.5 w-3.5 fill-marigold-500 text-marigold-500"
                                                />
                                                {rating.toFixed(1)} ·{" "}
                                                {reviews} reviews
                                            </span>
                                        )}
                                    </span>
                                    <span class="hidden shrink-0 text-sm font-bold text-ink-900 sm:block">
                                        {formatCardPrice(product)}
                                    </span>
                                    <Icon
                                        name="lucide:arrow-up-right"
                                        class="h-4 w-4 shrink-0 text-ink-300 transition group-hover:text-poppy-600"
                                    />
                                </a>
                            </li>
                        );
                    })
                }
            </ol>

            <div class="rounded-3xl bg-butter-50 p-6 ring-1 ring-ink-900/10 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <Badge tone="olive" size="sm">Bundles</Badge>
                        <h3 class="mt-3 font-display text-2xl leading-tight text-ink-900">
                            Skip the guesswork.
                        </h3>
                        <p class="mt-2 text-sm leading-6 text-ink-500">
                            Ready-made sets for a first project, a gift or a
                            whole new hobby.
                        </p>
                    </div>
                    <Icon
                        name="lucide:gift"
                        class="h-7 w-7 shrink-0 text-clay-500"
                    />
                </div>

                <ul class="mt-6 space-y-3">
                    {
                        bundles.map((bundle) => {
                            const image = bundle.images[0];
                            return (
                                <li>
                                    <a
                                        href={`/shop/${bundle.slug}/`}
                                        class="group flex items-center gap-4 rounded-2xl bg-white/70 p-3 ring-1 ring-ink-900/5 transition hover:bg-white hover:shadow-sm"
                                    >
                                        <img
                                            src={image?.src}
                                            alt={image?.alt ?? bundle.name}
                                            loading="lazy"
                                            decoding="async"
                                            class="h-14 w-14 shrink-0 rounded-xl bg-cream-200 object-cover"
                                        />
                                        <span class="min-w-0 flex-1">
                                            <span class="block font-display text-base leading-snug text-ink-900">
                                                {bundle.name}
                                            </span>
                                            <span class="mt-0.5 block text-xs font-semibold text-ink-500">
                                                {formatCardPrice(bundle)}
                                            </span>
                                        </span>
                                        <Icon
                                            name="lucide:arrow-right"
                                            class="h-4 w-4 shrink-0 text-ink-300 transition group-hover:translate-x-0.5 group-hover:text-poppy-600"
                                        />
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>

                <p class="mt-6 flex items-start gap-2 border-t border-ink-900/10 pt-4 text-xs leading-5 text-ink-500">
                    <Icon
                        name="lucide:sparkles"
                        class="mt-0.5 h-4 w-4 shrink-0 text-olive-600"
                    />
                    Every order over KES {threshold} gets a free craft gift
                    tucked in.
                </p>
            </div>
        </div>
    </div>
</section>
