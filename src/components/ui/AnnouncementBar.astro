---
/**
 * Slim alert bar that shows one announcement at a time. Each message drops in
 * from the top, holds, then falls out the bottom while the next drops in.
 *
 * Pure CSS: every message runs the same keyframes, offset by its slot. The
 * keyframe percentages depend on the message count, so they're generated
 * here. Each keyframe segment sets its own animation-timing-function:
 *   enter - overshoots slightly and settles (like a card landing)
 *   hold  - linear (nothing moves)
 *   exit  - accelerates away, as if gravity took it
 */
interface Props {
  items: string[];
  label?: string;
  /** Seconds each message is the current one. */
  slot?: number;
}

const { items, label = 'Shop announcements', slot = 4.5 } = Astro.props;

const ENTER = 0.7; // s
const EXIT = 0.5; // s, overlaps the next message's entrance

const animated = items.length > 1;
const total = items.length * slot;
const pct = (seconds: number) => `${((seconds / total) * 100).toFixed(3)}%`;

const EASE_ENTER = 'cubic-bezier(0.34, 1.56, 0.64, 1)'; // = --ease-bounce
const EASE_EXIT = 'cubic-bezier(0.55, 0, 1, 0.45)'; // ease-in, "falls"

const keyframes = animated
  ? `
@keyframes announcement-drop {
  0% { transform: translateY(-110%); opacity: 0; animation-timing-function: ${EASE_ENTER}; }
  ${pct(ENTER)} { transform: translateY(0); opacity: 1; animation-timing-function: linear; }
  ${pct(slot)} { transform: translateY(0); opacity: 1; animation-timing-function: ${EASE_EXIT}; }
  ${pct(slot + EXIT)}, 100% { transform: translateY(110%); opacity: 0; }
}
@keyframes announcement-fade {
  0% { opacity: 0; animation-timing-function: ease-out; }
  ${pct(ENTER)} { opacity: 1; animation-timing-function: linear; }
  ${pct(slot)} { opacity: 1; animation-timing-function: ease-in; }
  ${pct(slot + EXIT)}, 100% { opacity: 0; }
}`
  : '';
---

<div
  class="announcement-bar relative h-8 overflow-hidden border-b border-cream-50/10 bg-olive-700 text-cream-50"
  role="region"
  aria-label={label}
  data-animated={animated ? '' : undefined}
  style={`--announcement-total:${total}s`}
>
  {animated && <style is:inline set:html={keyframes} />}
  <ul class="h-full">
    {
      items.map((item, index) => (
        <li
          class="announcement-item absolute inset-0 flex items-center justify-center px-4"
          style={
            // Shifted back by ENTER so the first message is already in place
            // on page load instead of dropping in on every navigation.
            animated ? `animation-delay:${index * slot - ENTER}s` : undefined
          }
        >
          <span class="truncate text-[0.62rem] font-bold uppercase tracking-[0.16em] sm:text-[0.66rem]">
            {item}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  [data-animated] .announcement-item {
    opacity: 0;
    animation: announcement-drop var(--announcement-total) infinite both;
  }

  /* Let people finish reading. */
  .announcement-bar:hover .announcement-item,
  .announcement-bar:focus-within .announcement-item {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animated] .announcement-item {
      animation-name: announcement-fade;
    }
  }
</style>
