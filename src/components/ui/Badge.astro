---
interface Props {
  tone?: 'clay' | 'ink' | 'olive' | 'poppy' | 'marigold' | 'bubblegum' | 'cream';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  tone = 'clay',
  size = 'md',
  class: className,
} = Astro.props;

const tones: Record<string, string> = {
  clay: 'bg-clay-500 text-cream-50',
  ink: 'bg-ink-900 text-cream-50',
  olive: 'bg-olive-700 text-cream-50',
  poppy: 'bg-poppy-500 text-cream-50',
  marigold: 'bg-marigold-500 text-ink-900',
  bubblegum: 'bg-bubblegum-500 text-cream-50',
  cream: 'bg-cream-50 text-ink-900 ring-1 ring-ink-900/10',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full font-bold uppercase tracking-[0.14em]',
    size === 'sm' ? 'px-2.5 py-1 text-[0.6rem]' : 'px-3 py-1.5 text-[0.62rem]',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
