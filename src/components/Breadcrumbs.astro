---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-ink-300">
    <li><a class="hover:text-clay-600" href="/">Home</a></li>
    {items.map((item) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {item.href ? (
          <a class="hover:text-clay-600" href={item.href}>{item.label}</a>
        ) : (
          <span class="text-ink-700">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
