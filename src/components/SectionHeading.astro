---
import Icon from './ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  link?: { href: string; label: string };
  align?: 'left' | 'center';
}

const { eyebrow, title, description, link, align = 'left' } = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-6 md:flex-row md:items-end md:justify-between',
    align === 'center' && 'md:flex-col md:items-center md:text-center',
  ]}
>
  <div class:list={['max-w-2xl', align === 'center' && 'mx-auto']}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="mt-3 text-balance text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
      {title}
    </h2>
    {description && (
      <p class="mt-4 text-base leading-7 text-ink-500">{description}</p>
    )}
  </div>

  {link && (
    <a
      href={link.href}
      class="group inline-flex items-center gap-2 self-start text-sm font-bold text-ink-900 md:self-auto"
    >
      {link.label}
      <span
        class="grid h-8 w-8 place-items-center rounded-full border border-ink-900/20 transition group-hover:border-ink-900 group-hover:bg-ink-900 group-hover:text-cream-50"
        aria-hidden="true"
      >
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </span>
    </a>
  )}
</div>
