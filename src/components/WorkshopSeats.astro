---
import type { Workshop } from '../lib/types';
import { seatsSummary } from '../lib/workshop-seats';

interface Props {
  workshop: Workshop;
  /** "dark" for olive/ink backgrounds. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { workshop, tone = 'light', class: className } = Astro.props;

// The bar fills up as seats are taken (not down as they run out), so a full
// session reads as a full bar.
const { state, status, detail, taken, percent } = seatsSummary(workshop);

const dark = tone === 'dark';
---

<div
  class:list={['group', className]}
  data-workshop-seats={workshop.id}
  data-capacity={workshop.capacity}
  data-state={state}
>
  <div class="flex items-baseline justify-between gap-4 text-xs">
    <span
      data-seats-status
      class:list={[
        'font-bold uppercase tracking-[0.12em]',
        dark
          ? 'text-olive-100/70 group-data-[state=full]:text-marigold-500 group-data-[state=low]:text-marigold-500'
          : 'text-ink-400 group-data-[state=full]:text-poppy-600 group-data-[state=low]:text-poppy-600',
      ]}
    >
      {status}
    </span>
    <span data-seats-detail class:list={['font-semibold', dark ? 'text-cream-50' : 'text-ink-900']}>
      {detail}
    </span>
  </div>
  <div
    class:list={['mt-2 h-2 overflow-hidden rounded-full', dark ? 'bg-cream-50/15' : 'bg-ink-900/10']}
    role="meter"
    aria-label="Seats taken"
    aria-valuemin="0"
    aria-valuemax={workshop.capacity}
    aria-valuenow={taken}
    aria-valuetext={detail}
  >
    <div
      data-seats-bar
      class:list={[
        'h-full rounded-full bg-olive-500 group-data-[state=low]:bg-poppy-500',
        dark ? 'group-data-[state=full]:bg-cream-50/60' : 'group-data-[state=full]:bg-ink-900/60',
      ]}
      style={`width: ${percent}%`}
    />
  </div>
</div>
