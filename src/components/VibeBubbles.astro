---
import Icon from "./ui/Icon.astro";
import { demoVibes } from "../lib/demo-data";

const icons: Record<string, string> = {
    paint: "lucide:palette",
    "stitch-sew": "lucide:scissors",
    kids: "lucide:shapes",
    restock: "lucide:package",
};

const tilts = ["-rotate-2", "rotate-2", "rotate-1", "-rotate-1"];
const offsets = ["lg:mt-0", "lg:mt-12", "lg:mt-4", "lg:mt-14"];
---

<section class="bg-butter-50 py-16 sm:py-20">
    <div class="container-page">
        <div
            class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
        >
            <div class="max-w-2xl">
                <p class="eyebrow text-clay-600">Creative vibes</p>
                <h2
                    class="mt-3 text-balance text-4xl leading-[1.05] tracking-tight text-ink-900 sm:text-5xl"
                >
                    What are you in the mood to make?
                </h2>
            </div>
            <p class="max-w-sm text-sm leading-7 text-ink-500">
                Pick a mood and we will point you at the good stuff. No wrong
                turns, no gatekeeping — just a friendly nudge in the right
                direction.
            </p>
        </div>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4 lg:gap-5">
            {
                demoVibes.map((vibe, index) => (
                    <a
                        href={vibe.href}
                        class:list={[
                            "group relative flex aspect-square flex-col items-center justify-center gap-2 overflow-hidden rounded-full p-5 text-center transition duration-500 ease-bounce hover:-translate-y-2 hover:rotate-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-poppy-500 sm:gap-3 sm:p-7",
                            tilts[index % tilts.length],
                            offsets[index % offsets.length],
                        ]}
                        style={`background-color: ${vibe.accent}`}
                    >
                        <span class="grid h-8 w-8 place-items-center rounded-full bg-white/70 text-ink-900 shadow-sm sm:h-10 sm:w-10">
                            <Icon
                                name={icons[vibe.slug] ?? "lucide:sparkles"}
                                class="h-4 w-4 sm:h-5 sm:w-5"
                            />
                        </span>

                        <span class="text-balance font-display text-sm leading-tight text-ink-900 sm:text-lg xl:text-2xl">
                            {vibe.title}
                        </span>

                        <span class="hidden max-w-[15rem] text-[0.7rem] leading-5 text-ink-600 xl:block">
                            {vibe.description}
                        </span>

                        <span class="mt-1 hidden items-center gap-1 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-ink-700 transition group-hover:gap-2 sm:inline-flex sm:text-[0.66rem]">
                            Shop this vibe
                            <Icon
                                name="lucide:arrow-up-right"
                                class="h-3.5 w-3.5"
                            />
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</section>
