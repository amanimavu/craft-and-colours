# Public storefront URL (used for canonical URLs, sitemap, and JSON-LD)
SITE_URL=https://craftandcolours.co.ke

# Public URL of the headless WordPress + WooCommerce install
# Used by the browser for Store API cart/checkout calls and the contact form.
PUBLIC_WC_STORE_URL=https://cms.craftandcolours.co.ke

# Build-time WordPress REST URL. Must be the same install as PUBLIC_WC_STORE_URL
# (workshops, maker posts, journal). Leave blank to use demo content.
# Local testing: http://localhost:8080 — see docs/wordpress-local.md
WP_URL=https://cms.craftandcolours.co.ke

# Store contact details
PUBLIC_CONTACT_EMAIL=hello@craftandcolours.co.ke
PUBLIC_WHATSAPP=+254700000000
PUBLIC_INSTAGRAM=craftandcolours
PUBLIC_FACEBOOK_URL=https://www.facebook.com/craft.colours.ke
