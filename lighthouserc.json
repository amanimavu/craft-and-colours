{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "numberOfRuns": 1,
            "url": [
                "http://127.0.0.1/",
                "http://127.0.0.1/shop/",
                "http://127.0.0.1/shop/chunky-cotton-yarn/",
                "http://127.0.0.1/workshops/",
                "http://127.0.0.1/workshops/paint-and-sip-nairobi-sunset/",
                "http://127.0.0.1/diy-kits/",
                "http://127.0.0.1/journal/",
                "http://127.0.0.1/journal/choosing-your-first-paint-set/",
                "http://127.0.0.1/about/",
                "http://127.0.0.1/contact/",
                "http://127.0.0.1/policies/"
            ],
            "settings": {
                "skipAudits": [
                    "canonical"
                ]
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "warn",
                    {
                        "minScore": 0.8
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:best-practices": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "cumulative-layout-shift": [
                    "error",
                    {
                        "maxNumericValue": 0.1
                    }
                ],
                "largest-contentful-paint": [
                    "warn",
                    {
                        "maxNumericValue": 4000
                    }
                ],
                "total-blocking-time": [
                    "warn",
                    {
                        "maxNumericValue": 500
                    }
                ]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}
