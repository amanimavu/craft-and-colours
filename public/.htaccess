# Craft & Colours — static storefront (Host Africa, Apache / LiteSpeed)
#
# Lives in public/ so Astro copies it into dist/ on every build. Do not edit it
# on the server: the next deploy overwrites it.
#
# If the site returns HTTP 500 straight after a deploy, the host is refusing one
# of these directives (AllowOverride). Comment out the matching block and
# re-upload. See docs/deploy-hostafrica.md §8.

AddDefaultCharset UTF-8
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# Redirects: HTTPS, then www -> apex
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Hashed build assets (/_astro/…) never change, so they can be cached hard.
    RewriteRule ^_astro/ - [E=HASHED_ASSET:1,L]
</IfModule>

# ---------------------------------------------------------------------------
# 404 — Astro emits 404.html at the site root
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Only sent over HTTPS, where browsers honour it.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    Header append Vary Accept-Encoding
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#   HTML        -> no-cache, so a WordPress rebuild shows up immediately
#   /_astro/*   -> immutable (filenames are content-hashed)
#   everything else -> 7 days
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
# No directory listings (works even when Indexes is enabled globally).
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# Never serve dotfiles (.env, .git*, .htaccess itself) or build metadata.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(package(-lock)?\.json|composer\.(json|lock)|tsconfig\.json)$">
        Require all denied
    </FilesMatch>
</IfModule>
